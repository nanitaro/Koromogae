<Window x:Class="Koromogae.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Koromogae"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Koromogae" Height="800" Width="860" MinHeight="640" MinWidth="720"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
    </Window.Resources>
    <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top">
        <!-- 左から オプション / Language / ヘルプ の順 (すべて左寄せ。既定の WrapPanel のまま) -->
        <MenuItem x:Name="OptionsMenu" Header="{local:T Menu.Options}">
            <MenuItem x:Name="MinimizeToTrayMenuItem" Header="{local:T Menu.MinimizeToTray}" IsCheckable="True" Click="MinimizeToTrayMenuItem_Click"/>
        </MenuItem>
        <!-- 言語の選択: どの言語の画面でも見つけられるよう、見出しは「Language」の語を含み (日本語 Language(_L) / 英語 _Language)、項目は翻訳せず固定の表記にする。選ぶと再起動で反映 -->
        <MenuItem x:Name="LanguageMenu" Header="{local:T Menu.Language}">
            <MenuItem x:Name="LanguageAutoItem" Header="自動 (Windows の設定) / Auto" Tag="Auto" IsCheckable="True" Click="LanguageItem_Click"/>
            <MenuItem x:Name="LanguageJapaneseItem" Header="日本語" Tag="Japanese" IsCheckable="True" Click="LanguageItem_Click"/>
            <MenuItem x:Name="LanguageEnglishItem" Header="English" Tag="English" IsCheckable="True" Click="LanguageItem_Click"/>
        </MenuItem>
        <MenuItem x:Name="HelpMenu" Header="{local:T Menu.Help}">
            <MenuItem x:Name="OpenManualMenuItem" Header="{local:T Menu.OpenManual}" Click="OpenManualMenuItem_Click"/>
            <MenuItem x:Name="AboutMenuItem" Header="{local:T Menu.About}" Click="AboutMenuItem_Click"/>
            <MenuItem x:Name="OpenDataFolderMenuItem" Header="{local:T Menu.OpenDataFolder}" Click="OpenDataFolderMenuItem_Click"/>
        </MenuItem>
    </Menu>
    <Grid Margin="10,4,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- プラグインのグループ: 高さが足りなくても、一覧とボタンの列がそれぞれスクロールするので、小さい下限でよい -->
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="{local:T Main.Audio.Group}" Grid.Row="0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Margin" Value="0,3,12,3"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:T Main.Api.Label}"/>
                <ComboBox x:Name="ApiCombo" Grid.Row="0" Grid.Column="1" SelectionChanged="ApiCombo_SelectionChanged"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{local:T Main.SampleRate.Label}"/>
                <ComboBox x:Name="RateCombo" Grid.Row="0" Grid.Column="3"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:T Main.InputDevice.Label}"/>
                <ComboBox x:Name="InputCombo" Grid.Row="1" Grid.Column="1"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{local:T Main.Buffer.Label}"/>
                <ComboBox x:Name="LatencyCombo" Grid.Row="1" Grid.Column="3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:T Main.InputFormat.Label}"
                           ToolTip="{local:T Tip.InputFormat}"/>
                <ComboBox x:Name="InputFormatCombo" Grid.Row="2" Grid.Column="1"
                          ToolTip="{local:T Tip.InputFormat}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{local:T Main.Cushion.Label}"
                           ToolTip="{local:T Tip.Cushion}"/>
                <ComboBox x:Name="CushionCombo" Grid.Row="2" Grid.Column="3"
                          ToolTip="{local:T Tip.Cushion}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:T Main.OutputDevice.Label}"/>
                <ComboBox x:Name="OutputCombo" Grid.Row="3" Grid.Column="1"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{local:T Main.OutputFormat.Label}"
                           ToolTip="{local:T Tip.OutputFormat}"/>
                <ComboBox x:Name="OutputFormatCombo" Grid.Row="4" Grid.Column="1" SelectionChanged="OutputFormatCombo_SelectionChanged"
                          ToolTip="{local:T Tip.OutputFormat}"/>
                <TextBlock x:Name="DitherLabel" Grid.Row="3" Grid.Column="2" Text="{local:T Main.Dither.Label}"
                           ToolTip="{local:T Tip.Dither}"/>
                <ComboBox x:Name="DitherCombo" Grid.Row="3" Grid.Column="3" SelectionChanged="DitherCombo_SelectionChanged"
                          ToolTip="{local:T Tip.Dither}"/>
                <Button x:Name="RefreshButton" Grid.Row="4" Grid.Column="3" Content="{local:T Main.Refresh}" Margin="0,3,12,3" Click="RefreshButton_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{local:T Main.Plugins.Group}" Grid.Row="1" Padding="8" Margin="0,6,0,0">
            <DockPanel>
                <!-- 高さが足りないときは、ボタンの列にスクロールバーが出る (ボタンが隠れて押せなくならない)。プラグインの一覧 (ListBox) も、長ければ自分でスクロールする -->
                <ScrollViewer x:Name="PluginButtonsScroll" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Padding" Value="4,4"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="{local:T Main.Plugin.Add}" Click="AddPlugin_Click"/>
                    <Button Content="{local:T Main.Plugin.AddBundle}" Click="AddBundle_Click" ToolTip="{local:T Main.Plugin.AddBundle.Tip}"/>
                    <Button Content="{local:T Main.Plugin.Remove}" Click="RemovePlugin_Click"/>
                    <Button Content="{local:T Main.Plugin.Up}" Click="MoveUp_Click"/>
                    <Button Content="{local:T Main.Plugin.Down}" Click="MoveDown_Click"/>
                    <Button Content="{local:T Main.Plugin.Editor}" Click="OpenEditor_Click" ToolTip="{local:T Main.Plugin.Editor.Tip}"/>
                    <Button Content="{local:T Main.Plugin.Params}" Click="OpenParameters_Click" ToolTip="{local:T Main.Plugin.Params.Tip}"/>
                </StackPanel>
                </ScrollViewer>
                <ListBox x:Name="PluginList" HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="PluginList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{local:T Main.Plugin.Enabled.Tip}"/>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="{local:T Rec.Group}" Grid.Row="3" Padding="8" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:T Rec.Folder.Label}"/>
                <TextBox x:Name="RecordFolderBox" Grid.Row="0" Grid.Column="1" Margin="0,3,8,3" VerticalContentAlignment="Center"
                         ToolTip="{local:T Tip.RecordFolder}"/>
                <Button x:Name="RecordBrowseButton" Grid.Row="0" Grid.Column="2" Content="{local:T Rec.Browse}" Padding="12,2" Margin="0,3,0,3"
                        Click="RecordBrowse_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:T Rec.Depth.Label}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <ComboBox x:Name="RecordDepthCombo" Width="120" Margin="0,3,16,3" SelectionChanged="RecordDepthCombo_SelectionChanged"
                              ToolTip="{local:T Tip.RecordDepth}">
                        <!-- FLAC のとき、Float32 は選べない (項目ごとの有効・無効は DepthItem.Enabled) -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="{local:T Rec.Format.Label}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{local:T Tip.RecordFormat}"/>
                    <ComboBox x:Name="RecordFormatCombo" Width="90" Margin="0,3,8,3" SelectionChanged="RecordFormatCombo_SelectionChanged"
                              ToolTip="{local:T Tip.RecordFormat}"/>
                    <Button x:Name="RecordOptionsButton" Content="{local:T Rec.Options}" Padding="10,2" Margin="0,3,16,3" Click="RecordOptions_Click"
                            ToolTip="{local:T Tip.RecordOptions}"/>
                    <CheckBox x:Name="RecordDryCheck" Content="{local:T Rec.Dry}" VerticalAlignment="Center"
                              ToolTip="{local:T Tip.RecordDry}"/>
                </StackPanel>

                <Button x:Name="RecordButton" Grid.Row="2" Grid.Column="0" Content="{local:T Rec.Button}" Width="110" Padding="4,4" Margin="0,6,12,0"
                        IsEnabled="False" Click="RecordButton_Click" ToolTip="{local:T Tip.RecordButton}"/>
                <TextBlock x:Name="RecordStatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Text="{local:T Rec.Status.Stopped}"
                           TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{local:T Play.Group}" Grid.Row="2" Padding="8" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Content="{local:T Play.Start}" Width="110" Height="48" FontSize="16" Click="StartButton_Click"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:T Play.Meter.In}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="InputMeter" Grid.Column="1" Minimum="0" Maximum="1" Height="10" Foreground="#06B025"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:T Play.Meter.Out}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="OutputMeter" Grid.Column="1" Minimum="0" Maximum="1" Height="10" Foreground="#06B025"/>
                    </Grid>
                    <TextBlock x:Name="LatencyText" Text="{local:T Play.Latency.Initial}" Margin="0,2,0,2" ToolTip="{local:T Tip.Latency}"/>
                    <TextBlock x:Name="DiagnosticsText" Text="{local:T Play.Diag.Initial}" Margin="0,0,0,2" ToolTip="{local:T Tip.Diagnostics}"/>
                    <TextBlock x:Name="StatusText" Text="{local:T Play.Status.Stopped}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
    </DockPanel>
</Window>

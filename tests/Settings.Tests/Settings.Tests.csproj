<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Koromogae</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- 配布物の HTML マニュアルを作る tools\ManualBuilder の変換 (ManualHtml) を検査するため。ビルド用ツールと同じ版 -->
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <!-- WPF 本体 (exe) を参照せず、依存のない 3 ファイルだけをソースごと取り込む。internal の Sanitize も直接テストできる -->
  <ItemGroup>
    <Compile Include="..\..\tools\ManualBuilder\ManualHtml.cs" Link="Linked\ManualHtml.cs" />
    <Compile Include="..\..\Localization\Loc.cs" Link="Linked\Loc.cs" />
    <Compile Include="..\..\Localization\UiLanguage.cs" Link="Linked\UiLanguage.cs" />
    <!-- 画面の文字列の表 (日本語 + 英語)。リソース名 (Koromogae.Resources.Strings) を本体とそろえるため、RootNamespace を Koromogae にしている -->
    <EmbeddedResource Include="..\..\Resources\Strings.resx" Link="Resources\Strings.resx" />
    <EmbeddedResource Include="..\..\Resources\Strings.en.resx" Link="Resources\Strings.en.resx" />
    <Compile Include="..\..\AppSettings.cs" Link="Linked\AppSettings.cs" />
    <Compile Include="..\..\AppLog.cs" Link="Linked\AppLog.cs" />
    <Compile Include="..\..\AppPaths.cs" Link="Linked\AppPaths.cs" />
    <Compile Include="..\..\Audio\ApiKind.cs" Link="Linked\ApiKind.cs" />
    <Compile Include="..\..\Audio\FormatChoice.cs" Link="Linked\FormatChoice.cs" />
    <Compile Include="..\..\Audio\DitherMode.cs" Link="Linked\DitherMode.cs" />
    <Compile Include="..\..\Audio\RecordDepth.cs" Link="Linked\RecordDepth.cs" />
    <Compile Include="..\..\Audio\RecordFormat.cs" Link="Linked\RecordFormat.cs" />
  </ItemGroup>

  <!-- ソースと文字列の表の場所 (多言語対応の検査が、製品コードの走査に使う) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Koromogae</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <!-- WPF 本体も PortAudio も参照せず、依存のない Pcm / LatencyInfo / DiagnosticsInfo だけをソースごと取り込む -->
  <ItemGroup>
    <Compile Include="..\..\Localization\Loc.cs" Link="Linked\Loc.cs" />
    <!-- 画面の文字列の表 (日本語 + 英語)。リソース名 (Koromogae.Resources.Strings) を本体とそろえるため、RootNamespace を Koromogae にしている -->
    <EmbeddedResource Include="..\..\Resources\Strings.resx" Link="Resources\Strings.resx" />
    <EmbeddedResource Include="..\..\Resources\Strings.en.resx" Link="Resources\Strings.en.resx" />
    <Compile Include="..\..\Audio\Pcm.cs" Link="Linked\Pcm.cs" />
    <Compile Include="..\..\Audio\DitherMode.cs" Link="Linked\DitherMode.cs" />
    <Compile Include="..\..\Audio\NoiseShaping.cs" Link="Linked\NoiseShaping.cs" />
    <Compile Include="..\..\Audio\PerceptualWeights.cs" Link="Linked\PerceptualWeights.cs" />
    <Compile Include="..\..\Audio\CallbackWatch.cs" Link="Linked\CallbackWatch.cs" />
    <Compile Include="..\..\Audio\StereoRing.cs" Link="Linked\StereoRing.cs" />
    <Compile Include="..\..\Audio\RecordDepth.cs" Link="Linked\RecordDepth.cs" />
    <Compile Include="..\..\Audio\RecordQueue.cs" Link="Linked\RecordQueue.cs" />
    <Compile Include="..\..\Audio\WavWriter.cs" Link="Linked\WavWriter.cs" />
    <Compile Include="..\..\Audio\IAudioFileWriter.cs" Link="Linked\IAudioFileWriter.cs" />
    <Compile Include="..\..\Audio\FlacWriter.cs" Link="Linked\FlacWriter.cs" />
    <Compile Include="..\..\Audio\RecordFormat.cs" Link="Linked\RecordFormat.cs" />
    <Compile Include="..\..\Audio\Recorder.cs" Link="Linked\Recorder.cs" />
    <Compile Include="..\..\Audio\LatencyInfo.cs" Link="Linked\LatencyInfo.cs" />
    <Compile Include="..\..\Audio\DiagnosticsInfo.cs" Link="Linked\DiagnosticsInfo.cs" />
    <Compile Include="..\..\Audio\StreamStats.cs" Link="Linked\StreamStats.cs" />
    <Compile Include="..\..\Audio\AudioStats.cs" Link="Linked\AudioStats.cs" />
    <Compile Include="..\..\Audio\DiagnosticsLog.cs" Link="Linked\DiagnosticsLog.cs" />
    <Compile Include="..\..\Audio\FormatChoice.cs" Link="Linked\FormatChoice.cs" />
    <Compile Include="..\..\Audio\SampleFormats.cs" Link="Linked\SampleFormats.cs" />
  </ItemGroup>

</Project>

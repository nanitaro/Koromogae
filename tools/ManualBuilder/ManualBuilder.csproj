<Project Sdk="Microsoft.NET.Sdk">

  <!-- README.md / README.en.md から、配布物に付ける HTML のマニュアルを作るビルド用のツール (配布物には入らない)。
       Markdig (BSD-2-Clause) は、このツールだけが使う。Koromogae.csproj の BuildManuals ターゲットが dotnet run で呼ぶ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

</Project>
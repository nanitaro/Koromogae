<Window x:Class="Koromogae.ParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Koromogae"
        Title="{local:T Params.Title}" Height="420" Width="560" MinWidth="420" MinHeight="200"
        ShowInTaskbar="False">
    <DockPanel Margin="10">
        <DockPanel x:Name="ProgramPanel" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="{local:T Params.Presets}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ProgramCombo" SelectionChanged="ProgramCombo_SelectionChanged"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="{local:T Params.Reload}" Padding="12,3" Click="Reload_Click"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ParameterList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Value}"
                                    SmallChange="0.01" LargeChange="0.1" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Display}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
